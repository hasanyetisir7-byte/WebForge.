GEMINI_API_KEY=put_your_gemini_api_key_in_host_environment
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3000

# Supabase project settings (the URL and publishable key are public).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Keep the service-role key private. Never commit its real value.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET_SERVICE_ROLE_KEY
WEBFORGE_TEST_PRO_EMAIL=admin@example.com
